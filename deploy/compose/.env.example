# Copy to deploy/compose/.env; generate each value independently using:
# openssl rand -base64 48 | tr -d '\n'; echo
REDIS_PASSWORD=REPLACE_WITH_RANDOM_BASE64
ADMIN_CREDENTIAL=REPLACE_WITH_RANDOM_BASE64
APP_SECRET=REPLACE_WITH_RANDOM_BASE64

# Optional non-secret tuning (defaults shown):
# GAME_IDLE_SECONDS=7200
# GAME_LIFETIME_SECONDS=86400
# RESULT_RETENTION_SECONDS=3600
# JOIN_RATE_PER_MINUTE=30
